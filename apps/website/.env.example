# API (browser — exposed via Vite)
VITE_API_BASE_URL=http://localhost:3000

# Windows update manifest (build-time only — do NOT prefix with VITE_)
# Same public URL as GitHub UPDATE_MANIFEST_URL / desktop UPDATE_MANIFEST_URL.
# Railway (same bucket as API): {S3_PUBLIC_BASE_URL}/updates/windows/version.json
WEBSITE_UPDATE_MANIFEST_URL=
