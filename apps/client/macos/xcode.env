# Xcode 26+ may prepend the Metal toolchain to Swift link search paths even when the
# app does not use Metal shaders. That toolchain lacks usr/lib/swift/macosx, which
# produces noisy ld warnings for every Swift CocoaPod target.
#
# Flutter passes FLUTTER_XCODE_* variables to xcodebuild as build settings.
# TOOLCHAINS is also exported so plain `xcodebuild` / shell sessions pick it up.
#
# Applied automatically when:
#   - using ./flutterw (recommended)
#   - Cursor/VS Code integrated terminal (.vscode/settings.json)
#   - direnv (.envrc)
#
# Otherwise: source macos/xcode.env before flutter run/build on macOS.
export TOOLCHAINS=com.apple.dt.toolchain.XcodeDefault
export FLUTTER_XCODE_TOOLCHAINS=com.apple.dt.toolchain.XcodeDefault
