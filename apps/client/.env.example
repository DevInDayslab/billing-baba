# MSG91 Authentication
MSG91_WIDGET_ID=
MSG91_WIDGET_AUTH_TOKEN=

# Local development only — must be false in production builds
ENABLE_DEV_LOGIN=false

# Default OTP when MSG91 is not configured (development only)
DEV_OTP=123456

# Verbose auth/MSG91 debug logging (also enabled in debug builds)
DEBUG=false
APP_ENV=development

# API Base URL
API_BASE_URL=http://localhost:3000

# Public website (collaboration invite links)
WEBSITE_URL=https://billingbaba.com

# Debug only — use fake collaboration data instead of the API
USE_FAKE_COLLABORATION=false