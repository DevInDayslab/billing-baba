# Copy to `.env` and fill in values. Never commit `.env`.

# API (must include http:// or https:// — bare hostnames break Dio on desktop)
# - Desktop / iOS simulator: http://127.0.0.1:3000
# - Android emulator: http://127.0.0.1:3000 (auto-rewrites to 10.0.2.2)
# - Physical Android over USB: http://127.0.0.1:3000 + `adb reverse tcp:3000 tcp:3000`
# - Physical phone over Wi‑Fi: http://<your-pc-lan-ip>:3000 (same Wi‑Fi, firewall open)
API_BASE_URL=https://billing-baba-production-6b5e.up.railway.app
WEBSITE_URL=https://billingbaba.com

# Environment
APP_ENV=development
DEBUG=false
ENABLE_DEV_LOGIN=true
DEV_OTP=123456

# Logging
# FILE_LOGGING=true          # default true on desktop; set false to disable disk logs
# LOG_LEVEL=info             # debug | info | warn | error (default: info, or debug when verbose)
# VERBOSE_LOGGING=true       # verbose console output + HTTP traces

# MSG91 OTP (optional for local dev)
# MSG91_WIDGET_ID=
# MSG91_WIDGET_AUTH_TOKEN=
