MSG91_WIDGET_ID=
MSG91_WIDGET_AUTH_TOKEN=

# Alternate names (Krexhe-compatible)
# MSG91_MOBILE_WIDGET_ID=
# MSG91_MOBILE_WIDGET_TOKEN=

# Local development only — must be false in production builds
ENABLE_DEV_LOGIN=false

# Verbose auth/MSG91 debug logging (also enabled in debug builds)
DEBUG=false
APP_ENV=development
