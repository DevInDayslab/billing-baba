{
  "name": "flutter_inappwebview_ios",
  "version": "0.0.1",
  "summary": "A new Flutter plugin.",
  "description": "A new Flutter plugin.",
  "homepage": "http://example.com",
  "license": {
    "file": "../LICENSE"
  },
  "authors": {
    "Your Company": "email@example.com"
  },
  "source": {
    "path": "."
  },
  "source_files": "flutter_inappwebview_ios/Sources/flutter_inappwebview_ios/**/*.swift",
  "resources": "flutter_inappwebview_ios/Sources/flutter_inappwebview_ios/Resources/**/*.storyboard",
  "dependencies": {
    "Flutter": [],
    "swift-collections": [
      "~>1.1.1"
    ]
  },
  "resource_bundles": {
    "flutter_inappwebview_ios_privacy": [
      "flutter_inappwebview_ios/Sources/flutter_inappwebview_ios/Resources/PrivacyInfo.xcprivacy"
    ]
  },
  "pod_target_xcconfig": {
    "DEFINES_MODULE": "YES"
  },
  "libraries": "swiftCoreGraphics",
  "xcconfig": {
    "LIBRARY_SEARCH_PATHS": "$(TOOLCHAIN_DIR)/usr/lib/swift/$(PLATFORM_NAME)/ $(SDKROOT)/usr/lib/swift",
    "LD_RUNPATH_SEARCH_PATHS": "/usr/lib/swift"
  },
  "swift_versions": "5.0",
  "platforms": {
    "ios": "12.0"
  },
  "default_subspecs": "Core",
  "subspecs": [
    {
      "name": "Core",
      "platforms": {
        "ios": "12.0"
      }
    }
  ],
  "swift_version": "5.0"
}
