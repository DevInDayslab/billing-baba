APP_NAME=Billing Baba API
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=info

# Neon PostgreSQL (shared development database — no local PostgreSQL required)
# Example: postgres://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Production only — comma-separated allowed origins
CORS_ORIGINS=

# Public website
WEBSITE_URL=https://billingbaba.com

# Collaboration
INVITATION_EXPIRY_DAYS=7

# Authentication (required for auth module)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Msg91 Authentication
MSG91_AUTH_KEY=

# Local development only — must be false in production
ENABLE_DEV_LOGIN=false
DEV_PHONE=
DEV_OTP=

# Purchase bill document parsing — Gemini Developer API (Google AI Studio)
# Free key: https://aistudio.google.com/apikey (starts with AIza…, NOT Vertex/OAuth)
GEMINI_API_KEY=
# Optional override — defaults to gemini-flash-latest
# GEMINI_MODEL=gemini-flash-latest
# Optional legacy external parser URL (multipart POST with `file` field).
# PURCHASE_DOCUMENT_PARSE_URL=
# Dev-only empty parse response when GEMINI_API_KEY is not set.
ENABLE_MOCK_PURCHASE_PARSE=false

# Outbound notifications: console (default) | twilio
NOTIFICATION_PROVIDER=console

# Twilio WhatsApp (required when NOTIFICATION_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Public invoice share links
INVOICE_SHARE_EXPIRY_DAYS=90

# Dedupe window for outbound WhatsApp sends (hours)
NOTIFICATION_IDEMPOTENCY_TTL_HOURS=24

## Railway Object Storage (S3-compatible)
# Leave all empty to disable storage (API returns 503 on /storage/*).
# If any credential is set, all of ENDPOINT, BUCKET, ACCESS_KEY_ID, SECRET_ACCESS_KEY are required.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_SSL=true
# Optional public CDN/base URL for visibility=public assets
S3_PUBLIC_BASE_URL=
# Max upload size in bytes (default 10 MB)
STORAGE_MAX_FILE_BYTES=10485760
STORAGE_UPLOAD_URL_TTL_SECONDS=900
STORAGE_DOWNLOAD_URL_TTL_SECONDS=3600
